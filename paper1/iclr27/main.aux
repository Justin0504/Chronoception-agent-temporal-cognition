\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces The Three Times ontology. $\tau _{\mathrm  {wall}}$ (external clock), $\tau _{\mathrm  {step}}$ (policy invocations), and $\tau _{\mathrm  {self}}$ (agent-reported duration) are related by two mappings that current agents fail to learn. Grounded chronoception requires both.\relax }}{11}{figure.caption.24}\protected@file@percent }
\newlabel{fig:three_times}{{4}{11}{The Three Times ontology. $\twall $ (external clock), $\tstep $ (policy invocations), and $\tself $ (agent-reported duration) are related by two mappings that current agents fail to learn. Grounded chronoception requires both.\relax }{figure.caption.24}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Calibration Catastrophe. Nominal $90\%$ CIs on self-duration achieve $0$--$77\%$ coverage across the panel. Non-reasoning agents (left) uniformly under-cover by $\geq 40$\,pp; reasoning agents (right) show wider CIs that accidentally contain the truth via arithmetic inflation of $\tau _{\mathrm  {wall}}$, not learned chronoception.\relax }}{11}{figure.caption.25}\protected@file@percent }
\newlabel{fig:cal}{{5}{11}{Calibration Catastrophe. Nominal $90\%$ CIs on self-duration achieve $0$--$77\%$ coverage across the panel. Non-reasoning agents (left) uniformly under-cover by $\geq 40$\,pp; reasoning agents (right) show wider CIs that accidentally contain the truth via arithmetic inflation of $\twall $, not learned chronoception.\relax }{figure.caption.25}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Pre-registered P12 on METR HCAST (14{,}709 runs). Success-rate decay slope vs.\ $\qopname  \relax o{log}T$ for reasoning (red) and non-reasoning (blue) models. Reasoning models show steeper decay ($|\text  {slope}| = 0.318$ vs.\ $0.264$), consistent with Theorem\nobreakspace  {}\ref  {thm:rs}: more reasoning compute worsens temporal calibration at horizon.\relax }}{12}{figure.caption.26}\protected@file@percent }
\newlabel{fig:p12}{{6}{12}{Pre-registered P12 on METR HCAST (14{,}709 runs). Success-rate decay slope vs.\ $\log T$ for reasoning (red) and non-reasoning (blue) models. Reasoning models show steeper decay ($|\text {slope}| = 0.318$ vs.\ $0.264$), consistent with Theorem~\ref {thm:rs}: more reasoning compute worsens temporal calibration at horizon.\relax }{figure.caption.26}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Logical dependency arc of the paper's formal results. CIT (Theorem\nobreakspace  {}\ref  {thm:cit}) is the root; the Reverse-Scaling Theorem\nobreakspace  {}\ref  {thm:rs} and SIT (Theorem\nobreakspace  {}\ref  {thm:sit}) are direct corollaries under their respective assumptions. The Agentic Timeline (Hypothesis\nobreakspace  {}\ref  {hyp:at}) draws on both; the Calibration Catastrophe and Injection Tell are empirical consequences.\relax }}{12}{figure.caption.27}\protected@file@percent }
\newlabel{fig:arc}{{7}{12}{Logical dependency arc of the paper's formal results. CIT (Theorem~\ref {thm:cit}) is the root; the Reverse-Scaling Theorem~\ref {thm:rs} and SIT (Theorem~\ref {thm:sit}) are direct corollaries under their respective assumptions. The Agentic Timeline (Hypothesis~\ref {hyp:at}) draws on both; the Calibration Catastrophe and Injection Tell are empirical consequences.\relax }{figure.caption.27}{}}
