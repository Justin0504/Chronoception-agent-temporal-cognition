\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Four independent confirmations of Theorem\nobreakspace  {}\ref  {thm:rs}. \textbf  {(a)} Intra-model o4-mini effort ladder $1.23 \to 1.54 \to 1.67$. \textbf  {(b)} Cross-model Sonnet 4.6 $\pm $ thinking, median $|\rho | = 0.12 \to 0.21$ (Setting\nobreakspace  {}A, $n = 28/10$; signed median $+0.07 \to -0.17$); the sign flip is firm under Setting\nobreakspace  {}B ($-0.25$, CI $[-0.34, -0.11]$, $n = 16$). \textbf  {(c)} Within-model: Sonnet-thinking prospective ($+0.16$) vs.\ retrospective ($-0.25$) on the same tasks under Setting\nobreakspace  {}B --- sign flip. \textbf  {(d)} Cross-vendor: GLM-5.2 (Z.AI, no shared training pipeline with Anthropic), Setting\nobreakspace  {}A $\to $ B: $+0.16 \to -0.29$. The three Chinese-lab reasoning models (GLM-5.2, Kimi-K2.6, Qwen3.6-27B) collectively median $\rho \in [-0.97, -0.29]$ on Setting\nobreakspace  {}B --- Hidden-Time as a class property.\relax }}{5}{figure.caption.12}\protected@file@percent }
\newlabel{fig:rs}{{1}{5}{Four independent confirmations of Theorem~\ref {thm:rs}. \textbf {(a)} Intra-model o4-mini effort ladder $1.23 \to 1.54 \to 1.67$. \textbf {(b)} Cross-model Sonnet 4.6 $\pm $ thinking, median $|\confab | = 0.12 \to 0.21$ (Setting~A, $n = 28/10$; signed median $+0.07 \to -0.17$); the sign flip is firm under Setting~B ($-0.25$, CI $[-0.34, -0.11]$, $n = 16$). \textbf {(c)} Within-model: Sonnet-thinking prospective ($+0.16$) vs.\ retrospective ($-0.25$) on the same tasks under Setting~B --- sign flip. \textbf {(d)} Cross-vendor: GLM-5.2 (Z.AI, no shared training pipeline with Anthropic), Setting~A $\to $ B: $+0.16 \to -0.29$. The three Chinese-lab reasoning models (GLM-5.2, Kimi-K2.6, Qwen3.6-27B) collectively median $\rho \in [-0.97, -0.29]$ on Setting~B --- Hidden-Time as a class property.\relax }{figure.caption.12}{}}
