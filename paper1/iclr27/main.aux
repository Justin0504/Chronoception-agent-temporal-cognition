\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Four independent confirmations of Theorem\nobreakspace  {}\ref  {thm:rs}. \textbf  {(a)} Intra-model o4-mini effort ladder $1.23 \to 1.54 \to 1.67$. \textbf  {(b)} Cross-model Sonnet 4.6 $\pm $ thinking $0.12 \to 0.21$ (crosses $\varepsilon ^{*}$; Setting\nobreakspace  {}B $n=15$, CI $[-0.30, -0.10]$). \textbf  {(c)} Within-model: Sonnet-thinking prospective ($+0.16$) vs.\ retrospective ($-0.25$) on the same tasks --- sign flip. \textbf  {(d)} Cross-vendor: GLM-5.2 (Z.AI, no shared training pipeline with Anthropic), Setting\nobreakspace  {}A $\to $ B: $+0.16 \to -0.29$. The three Chinese-lab reasoning models (GLM-5.2, Kimi-K2.6, Qwen3.6-27B) collectively median $\rho \in [-0.97, -0.29]$ on Setting\nobreakspace  {}B --- Hidden-Time as a class property.\relax }}{5}{figure.caption.12}\protected@file@percent }
\newlabel{fig:rs}{{1}{5}{Four independent confirmations of Theorem~\ref {thm:rs}. \textbf {(a)} Intra-model o4-mini effort ladder $1.23 \to 1.54 \to 1.67$. \textbf {(b)} Cross-model Sonnet 4.6 $\pm $ thinking $0.12 \to 0.21$ (crosses $\ccestar $; Setting~B $n=15$, CI $[-0.30, -0.10]$). \textbf {(c)} Within-model: Sonnet-thinking prospective ($+0.16$) vs.\ retrospective ($-0.25$) on the same tasks --- sign flip. \textbf {(d)} Cross-vendor: GLM-5.2 (Z.AI, no shared training pipeline with Anthropic), Setting~A $\to $ B: $+0.16 \to -0.29$. The three Chinese-lab reasoning models (GLM-5.2, Kimi-K2.6, Qwen3.6-27B) collectively median $\rho \in [-0.97, -0.29]$ on Setting~B --- Hidden-Time as a class property.\relax }{figure.caption.12}{}}
