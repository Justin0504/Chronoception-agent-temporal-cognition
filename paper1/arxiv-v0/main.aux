\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The Three Times. $\tau _{\mathrm  {wall}}$ (external, continuous), $\tau _{\mathrm  {step}}$ (discrete policy invocations $a_0, a_1, \ldots  $), $\tau _{\mathrm  {self}}$ (agent's narrative of its own duration). A grounded policy enforces $\tau _{\mathrm  {wall}}\approx \tau _{\mathrm  {step}}\!\cdot \!\langle \Delta t\rangle \approx \tau _{\mathrm  {self}}$; the Augustine Problem is failure of this identity. Each axis carries an empirical law (L1--L3).}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:three-times}{{1}{4}{The Three Times. $\twall $ (external, continuous), $\tstep $ (discrete policy invocations $a_0, a_1, \ldots $), $\tself $ (agent's narrative of its own duration). A grounded policy enforces $\twall \approx \tstep \!\cdot \!\langle \Delta t\rangle \approx \tself $; the Augustine Problem is failure of this identity. Each axis carries an empirical law (L1--L3)}{figure.1}{}}
\newlabel{def:three-times}{{1}{4}{Three Times}{definition.1}{}}
